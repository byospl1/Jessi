# Variables de entorno para weekly_email/weekly_email.py
# Copia este archivo a .env (o expórtalas en tu shell) y llena los valores reales.
# NUNCA subas un .env con valores reales al repo.
# En producción (GitHub Actions) se configuran como repository secrets — ver weekly_email/README.md.

# Opcional, default: asesoriasjessi
FIREBASE_PROJECT_ID=

# Web API Key del proyecto Firebase (la misma que usa index.html / seed.mjs)
FIREBASE_API_KEY=

# Cuenta de Gmail que envía el correo semanal
GMAIL_USER=

# App Password de Gmail (16 caracteres, no la contraseña normal de la cuenta)
GMAIL_APP_PASSWORD=

# Destinatario del correo semanal
TO_EMAIL=
